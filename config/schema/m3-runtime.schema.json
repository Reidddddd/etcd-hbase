{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etcd-hbase M3 local runtime activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "member_id", "owner_lease_ms", "heartbeat_ms", "startup_timeout_ms",
    "shutdown_timeout_ms", "memory_bytes", "max_etcd_request_bytes",
    "pin_shards", "pin_slots_per_shard", "pin_lease_ms"
  ],
  "properties": {
    "member_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "owner_lease_ms": {"type": "integer", "minimum": 1000, "maximum": 600000},
    "heartbeat_ms": {"type": "integer", "minimum": 100, "maximum": 200000},
    "startup_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
    "shutdown_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 600000},
    "memory_bytes": {"type": "integer", "minimum": 268435456, "maximum": 1099511627776},
    "max_etcd_request_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "pin_shards": {"type": "integer", "minimum": 1, "maximum": 256},
    "pin_slots_per_shard": {"type": "integer", "minimum": 1, "maximum": 512},
    "pin_lease_ms": {"type": "integer", "minimum": 10, "maximum": 300000},
    "read_cache_enabled": {"type": "boolean", "const": false},
    "m4_lease_api_enabled": {"type": "boolean"},
    "lease_min_ttl_seconds": {"type": "integer", "minimum": 1, "maximum": 9000000000},
    "lease_clock_uncertainty_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "lease_maximum_bindings": {"type": "integer", "minimum": 1, "maximum": 1024},
    "lease_maximum_key_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "lease_maximum_revoke_cost_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}
  },
  "allOf": [
    {
      "if": {
        "properties": {"m4_lease_api_enabled": {"const": true}},
        "required": ["m4_lease_api_enabled"]
      },
      "then": {
        "required": [
          "lease_min_ttl_seconds", "lease_clock_uncertainty_ms", "lease_maximum_bindings",
          "lease_maximum_key_bytes", "lease_maximum_revoke_cost_bytes"
        ]
      }
    }
  ]
}
