{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etcd-hbase server runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "listeners",
    "hbase_profiles",
    "salt_profiles",
    "table_groups",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "listeners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Listener"
      },
      "maxItems": 64
    },
    "hbase_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/HBaseProfile"
      },
      "maxItems": 32
    },
    "salt_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SaltProfile"
      },
      "maxItems": 32
    },
    "table_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TableGroup"
      },
      "maxItems": 32
    },
    "resources": {
      "$ref": "#/$defs/ResourceBudgets"
    },
    "authentication": {
      "$ref": "#/$defs/M3AuthenticationConfiguration"
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "Listener": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bind_host",
        "port",
        "table_group_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ListenerIdentifier"
        },
        "bind_host": {
          "type": "string",
          "description": "The 253-character budget applies to the raw input, including a trailing dot or IPv6 brackets.",
          "minLength": 1,
          "maxLength": 253,
          "not": {
            "const": "*"
          }
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "table_group_id": {
          "$ref": "#/$defs/Identifier"
        },
        "tls": {
          "$ref": "#/$defs/ListenerTls"
        }
      }
    },
    "ListenerTls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_file", "private_key_file"],
      "properties": {
        "certificate_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "private_key_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        }
      }
    },
    "HBaseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "quorum",
        "client_port",
        "namespace",
        "authentication_mode"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "quorum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "client_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "not": {
            "enum": [
              "default",
              "hbase"
            ]
          }
        },
        "authentication_mode": {
          "$ref": "#/$defs/AuthenticationMode"
        },
        "credential_reference": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(env://[A-Z][A-Z0-9_]{0,127}|secret://[A-Za-z0-9][A-Za-z0-9._/-]{0,240})$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "authentication_mode": {
              "const": "DEV_NO_AUTH"
            }
          },
          "not": {
            "required": [
              "credential_reference"
            ]
          }
        },
        {
          "properties": {
            "authentication_mode": {
              "const": "CREDENTIAL_REFERENCE"
            }
          },
          "required": [
            "credential_reference"
          ]
        }
      ]
    },
    "SaltProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "strategy_id",
        "encoding_version",
        "bucket_count",
        "salt_width_bytes",
        "split_keys_hex"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "strategy_id": {
          "$ref": "#/$defs/Identifier"
        },
        "encoding_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "bucket_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "salt_width_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "split_keys_hex": {
          "type": "array",
          "maxItems": 1023,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8,
            "pattern": "^(?:[0-9a-fA-F]{2}){1,4}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "salt_width_bytes": {
                "const": 1
              }
            },
            "required": [
              "salt_width_bytes"
            ]
          },
          "then": {
            "properties": {
              "bucket_count": {
                "maximum": 256
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "salt_width_bytes": {
                "const": 2
              }
            },
            "required": [
              "salt_width_bytes"
            ]
          },
          "then": {
            "properties": {
              "bucket_count": {
                "maximum": 65536
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "salt_width_bytes": {
                "const": 3
              }
            },
            "required": [
              "salt_width_bytes"
            ]
          },
          "then": {
            "properties": {
              "bucket_count": {
                "maximum": 16777216
              }
            }
          }
        }
      ]
    },
    "TableGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "hbase_profile_id",
        "salt_profile_id",
        "identity_provider_id",
        "history_layout",
        "system_table",
        "history_candidates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "hbase_profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "salt_profile_id": {
          "$ref": "#/$defs/Identifier"
        },
        "identity_provider_id": {
          "$ref": "#/$defs/Identifier"
        },
        "history_layout": {
          "$ref": "#/$defs/HistoryLayout"
        },
        "system_table": {
          "$ref": "#/$defs/TableSchemaCandidate"
        },
        "history_candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/HistoryLayoutCandidate"
          }
        }
      }
    },
    "TableSchemaCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "schema_version",
        "profile_version",
        "column_families",
        "split_keys_hex",
        "record_categories",
        "identity_permissions"
      ],
      "properties": {
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}$"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "profile_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "column_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ColumnFamilySchema"
          },
          "maxItems": 8
        },
        "split_keys_hex": {
          "type": "array",
          "maxItems": 1023,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 8,
            "pattern": "^(?:[0-9a-fA-F]{2}){1,4}$"
          }
        },
        "record_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/RecordCategory"
          },
          "maxItems": 11,
          "uniqueItems": true
        },
        "identity_permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/IdentityPermission"
          },
          "maxItems": 16
        }
      }
    },
    "HistoryLayoutCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_layout",
        "tables"
      ],
      "properties": {
        "history_layout": {
          "$ref": "#/$defs/HistoryLayout",
          "not": {
            "const": "UNDECIDED"
          }
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/TableSchemaCandidate"
          }
        }
      }
    },
    "IdentityPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_ref",
        "permissions"
      ],
      "properties": {
        "identity_ref": {
          "$ref": "#/$defs/Identifier"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TablePermission"
          },
          "maxItems": 4,
          "uniqueItems": true
        }
      }
    },
    "ColumnFamilySchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "min_versions",
        "max_versions",
        "ttl_seconds",
        "keep_deleted_cells"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
        },
        "min_versions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "max_versions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "ttl_seconds": {
          "type": "integer",
          "oneOf": [
            {
              "const": -1
            },
            {
              "minimum": 1,
              "maximum": 2147483646
            }
          ]
        },
        "keep_deleted_cells": {
          "$ref": "#/$defs/KeepDeletedCells"
        }
      }
    },
    "ResourceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_config_bytes",
        "max_concurrent_requests",
        "max_scanners_per_table",
        "request_deadline_ms",
        "max_rpc_bytes",
        "max_request_bytes",
        "max_queued_requests"
      ],
      "properties": {
        "max_config_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_concurrent_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_scanners_per_table": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "request_deadline_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_rpc_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_queued_requests": {
          "type": "integer",
          "const": 0
        }
      }
    },
    "M3AuthenticationConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_domain",
        "session_ttl_millis",
        "session_slots",
        "maximum_identity_containers",
        "auth_control",
        "client_profiles",
        "endpoint_bindings",
        "background_identities",
        "credential_key_ring"
      ],
      "properties": {
        "trust_domain": {"$ref": "#/$defs/Identifier"},
        "session_ttl_millis": {"type": "integer", "minimum": 1000, "maximum": 2592000000},
        "session_slots": {"type": "integer", "minimum": 1, "maximum": 1024},
        "maximum_identity_containers": {"type": "integer", "minimum": 1, "maximum": 1024},
        "secret_directory": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"},
        "auth_control": {"$ref": "#/$defs/AuthControl"},
        "client_profiles": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/ClientProfile"}},
        "endpoint_bindings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/EndpointBinding"}},
        "background_identities": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/BackgroundIdentity"}},
        "credential_key_ring": {"$ref": "#/$defs/CredentialKeyRing"}
      }
    },
    "AuthControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hbase_profile_id", "salt_profile_id", "table_name", "provider_id", "client_profile_id", "identity"],
      "properties": {
        "hbase_profile_id": {"$ref": "#/$defs/Identifier"},
        "salt_profile_id": {"$ref": "#/$defs/Identifier"},
        "table_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"},
        "provider_id": {"$ref": "#/$defs/Identifier"},
        "client_profile_id": {"$ref": "#/$defs/Identifier"},
        "identity": {"$ref": "#/$defs/IdentityCredential"}
      }
    },
    "ClientProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hbase_profile_id", "authenticator_id", "hbase_site_file"],
      "properties": {
        "id": {"$ref": "#/$defs/Identifier"},
        "hbase_profile_id": {"$ref": "#/$defs/Identifier"},
        "authenticator_id": {"$ref": "#/$defs/Identifier"},
        "cluster_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "hbase_site_file": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^/"}
      }
    },
    "EndpointBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_group_id", "provider_id", "client_profile_id"],
      "properties": {
        "table_group_id": {"$ref": "#/$defs/Identifier"},
        "provider_id": {"$ref": "#/$defs/Identifier"},
        "client_profile_id": {"$ref": "#/$defs/Identifier"}
      }
    },
    "BackgroundIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_group_id", "provider_id", "client_profile_id", "identity", "allowed_table_group_ids"],
      "properties": {
        "table_group_id": {"$ref": "#/$defs/Identifier"},
        "provider_id": {"$ref": "#/$defs/Identifier"},
        "client_profile_id": {"$ref": "#/$defs/Identifier"},
        "identity": {"$ref": "#/$defs/IdentityCredential"},
        "allowed_table_group_ids": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/Identifier"}}
      }
    },
    "IdentityCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "credential_reference"],
      "properties": {
        "source": {"$ref": "#/$defs/CredentialSource"},
        "principal": {"type": "string", "minLength": 1, "maxLength": 512},
        "credential_reference": {"$ref": "#/$defs/CredentialReference"}
      }
    },
    "CredentialKeyRing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_key_id", "keys"],
      "properties": {
        "active_key_id": {"$ref": "#/$defs/Identifier"},
        "keys": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/KeyReference"}}
      }
    },
    "KeyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "secret_reference"],
      "properties": {
        "key_id": {"$ref": "#/$defs/Identifier"},
        "secret_reference": {"$ref": "#/$defs/SecretReference"}
      }
    },
    "CredentialReference": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(env://[A-Z][A-Z0-9_]{0,127}|secret://[A-Za-z0-9][A-Za-z0-9._/-]{0,240})$"
    },
    "SecretReference": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9._/-]{0,240}$"
    },
    "CredentialSource": {
      "type": "string",
      "enum": ["CREDENTIAL_REFERENCE", "KERBEROS_KEYTAB", "KERBEROS_TICKET_CACHE"]
    },
    "AuthenticationMode": {
      "type": "string",
      "enum": [
        "DEV_NO_AUTH",
        "CREDENTIAL_REFERENCE"
      ]
    },
    "HistoryLayout": {
      "type": "string",
      "enum": [
        "UNDECIDED",
        "SEPARATE_HISTORY_TABLE",
        "NATIVE_CELL_VERSIONS"
      ]
    },
    "KeepDeletedCells": {
      "type": "string",
      "enum": [
        "FALSE",
        "TRUE",
        "TTL"
      ]
    },
    "RecordCategory": {
      "type": "string",
      "enum": [
        "CURRENT",
        "HISTORY",
        "DECISION",
        "EVENT",
        "LEASE",
        "AUTH",
        "CONTROL",
        "INVOCATION",
        "CANDIDATE",
        "MANIFEST",
        "SNAPSHOT_PIN",
        "RESULT"
      ]
    },
    "TablePermission": {
      "type": "string",
      "enum": [
        "READ",
        "WRITE",
        "CREATE",
        "ADMIN"
      ]
    },
    "ListenerIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    }
  }
}
