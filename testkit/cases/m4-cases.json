          "overlaysSelectedMetadataOnlyCommitAndKeepsOtherLeaseAtStableSequence",
          "missingPageBudgetAndCorruptedStableStateFailClosed",
          "holdsPinUntilCancelledReadSettles",
          "refusesToUseOrFinishPinFromAnotherRequest",
          "refusesPinThatDoesNotProtectAuxiliaryHistory"
