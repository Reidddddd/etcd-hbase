      "maven_tests": [
        {"module": "core", "kind": "surefire", "class": "io.etcdhbase.core.lease.LeaseStateTest", "tests": [
          "preservesSignedWireIdAndSeparatesIncarnations",
          "grantsMinimumTtlAndRejectsOnlyValuesAboveMaximum",
