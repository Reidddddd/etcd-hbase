{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etcd-hbase.io/schema/trace/v1",
  "title": "etcd-hbase request trace v1",
  "description": "JSONL records for transport, native-etcd, target-hbase, and transport-fixture evidence. Protobuf snapshots are made field by field: bytes use base64 strings, int64/uint64 values use canonical decimal strings, and oneof selections are recorded explicitly. Authenticate name/password/token values and authorization metadata are never serialized; only field-presence flags are retained.",
  "$ref": "#/$defs/record",
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "case_id",
        "ordinal",
        "method",
        "request",
        "response",
        "error",
        "stream_terminal",
        "evidence_scope",
        "elapsed_ns"
      ],
      "properties": {
        "schema": {"const": "etcd-hbase-trace/v1"},
        "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "method": {"type": "string", "pattern": "^[A-Za-z0-9_.]+/[A-Za-z0-9_]+$"},
        "request": {"$ref": "#/$defs/protobuf_snapshot"},
        "response": {
          "oneOf": [
            {"$ref": "#/$defs/protobuf_snapshot"},
            {"type": "null"}
          ]
        },
        "error": {
          "oneOf": [
            {"$ref": "#/$defs/error"},
            {"type": "null"}
          ]
        },
        "stream_terminal": {
          "oneOf": [
            {"$ref": "#/$defs/stream_terminal"},
            {"type": "null"}
          ]
        },
        "evidence_scope": {
          "enum": ["transport", "transport-fixture", "native-etcd", "target-hbase"]
        },
        "elapsed_ns": {"$ref": "#/$defs/decimal_u64"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grpc_code", "consumer_kind"],
      "properties": {
        "grpc_code": {"$ref": "#/$defs/grpc_code"},
        "consumer_kind": {
          "enum": ["grpc-status", "etcd-client-error", "context-canceled", "context-deadline", "go-error"]
        }
      }
    },
    "stream_terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["eof", "grpc-status", "context-canceled", "context-deadline", "client-close"]},
        "grpc_code": {"$ref": "#/$defs/grpc_code"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "grpc-status"}}, "required": ["kind"]},
          "then": {"required": ["grpc_code"]}
        }
      ]
    },
    "protobuf_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "oneofs"],
      "properties": {
        "fields": {"$ref": "#/$defs/protobuf_fields"},
        "oneofs": {
          "type": "object",
          "description": "Oneof group name to selected proto field name, for example request -> request_range.",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "protobuf_fields": {
      "type": "object",
      "description": "Field names follow protobuf JSON names. Keys and values such as key/value/prevKv.key are base64 strings; int64 and uint64 fields such as revision, count, lease, term, id, ttl, and compactRevision are decimal strings. Nested protobuf messages use the same fields/oneofs envelope. Repeated values preserve their source order.",
      "additionalProperties": {"$ref": "#/$defs/protobuf_value"}
    },
    "protobuf_value": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array", "items": {"$ref": "#/$defs/protobuf_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/protobuf_value"}}
      ]
    },
    "base64_bytes": {
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "decimal_i64": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
    "decimal_u64": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "grpc_code": {
      "enum": [
        "Canceled",
        "DeadlineExceeded",
        "Unknown",
        "InvalidArgument",
        "NotFound",
        "AlreadyExists",
        "PermissionDenied",
        "ResourceExhausted",
        "FailedPrecondition",
        "Aborted",
        "OutOfRange",
        "Unauthenticated",
        "Internal",
        "Unavailable",
        "DataLoss",
        "Unimplemented"
      ]
    },
    "auth_request_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_present", "password_present"],
      "properties": {
        "name_present": {"type": "boolean"},
        "password_present": {"type": "boolean"}
      }
    },
    "auth_response_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_present"],
      "properties": {"token_present": {"type": "boolean"}}
    }
  }
}
